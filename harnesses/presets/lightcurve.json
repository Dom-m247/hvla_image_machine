{
  "harness": "lightcurve",
  "label": "every epoch within 100\"; the primary beam's field imaged and self-calibrated, target measured at its position",
  "options": {
    "batch_size": 4,
    "max_sep_arcsec": 100,
    "max_gb": 20
  },
  "seed": {
