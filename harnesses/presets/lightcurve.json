{
  "harness": "lightcurve",
  "label": "every epoch within 100\"; auto self-cal (6 cycles), cell sized per epoch",
  "options": {
    "batch_size": 4,
    "max_sep_arcsec": null,
    "max_gb": 20
  },
  "seed": {
    "decisions": {"self_cal": "auto","phase_cal": "force"},
    "self_cal_cycles": 6,
    "image_size": [1080, 1080],
    "use_custom_cell_size": false,
    "deconvolver": "mtmfs",
    "weighting": "briggs",
    "robust": 0.5,
    "mask": ""
  }
}
