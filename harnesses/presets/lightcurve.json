{
  "harness": "lightcurve",
  "label": "every epoch within 100\"; fixed imaging so epochs compare",
  "options": {
    "batch_size": 4,
    "max_sep_arcsec": 100,
    "max_gb": 20
  },
  "seed": {
    "decisions": {"self_cal": "off"},
    "image_size": [1024, 1024],
    "use_custom_cell_size": true,
    "cell_size": "0.08arcsec",
    "deconvolver": "mtmfs",
    "weighting": "briggs",
    "robust": 0.5,
    "mask": ""
  }
}
